target
.workspaces
deploy/local-proc/.kubeconfig
deploy/local-proc/server.log
deploy/local-proc/server.pid
.scarab
.env.local
.direnv

# Front-end + docs: npm projects, not cargo members.
ui/**/node_modules
ui/**/dist
ui/**/.astro

# Editor / OS cruft.
**/*.rs.bk
.DS_Store
