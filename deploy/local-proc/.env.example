# Local proc-mode dev stack — env template.
#
# The recipes (`just serve` / `ui` / `up`) copy this to `deploy/local-proc/.env`
# on first run, then source that. `.env` is gitignored (env files may hold
# secrets now or later — never commit them); edit your copy to customise.
#
# Real secrets for the in-cluster dogfood live in deploy/local-helm/.env.

# scarab-server: bind loopback on the dev port the UI proxies to.
SCARAB_ADDR=127.0.0.1:8080
# Durable store (the compose Postgres from up.sh; migrations run on connect).
SCARAB_DATABASE_URL=postgres://scarab:scarab@127.0.0.1:55432/scarab
# Object store: the compose MinIO.
SCARAB_S3_BUCKET=scarab-logs
SCARAB_S3_ENDPOINT=http://127.0.0.1:9000
SCARAB_S3_ACCESS_KEY=scarab
SCARAB_S3_SECRET_KEY=scarabsecret
SCARAB_S3_REGION=us-east-1
SCARAB_NAMESPACE=scarab
# Workspace service (ADR-0061). `up.sh` starts a SECOND scarab-server process
# with --role workspace bound to 0.0.0.0 on this port, and derives
# SCARAB_WORKSPACE_URL from the kind network's gateway so a Step Pod inside the
# cluster can reach a service running on the host. Dev secret; any string works.
SCARAB_WORKSPACE_TOKEN_SECRET=dev-workspace-token-secret
SCARAB_WORKSPACE_PORT=8081
# The warm tier's directory on the host. Deliberately NOT under
# ./.scarab/objects (the cold tier) — the whole point is two tiers, and one
# directory serving as both would make a warm miss impossible to observe.
SCARAB_WORKSPACE_DATA_DIR=./.scarab/workspace-cas
# Dev-only escape hatch (ADR-0048): boots without an authenticator/KEK, with
# loud warnings. Production must never set this.
SCARAB_DEV_INSECURE=1
# Vite dev server (`just ui`) proxies /v1 to this address (vite refuses to
# guess a default — see ui/scarab-web-ui/vite.config.ts).
SCARAB_API_URL=http://127.0.0.1:8080
