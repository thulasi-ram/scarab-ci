# The kind dev stack's host address: env template.
#
# `just up` and `just ui` read deploy/kind/.env, or this file when there is
# none. `.env` is gitignored; copy this file there to change the port.

# The host address the API and the web UI answer on. `just up` maps this host
# port to the server's node port when it creates the kind cluster, so changing
# it later needs the cluster recreated (SCARAB_KIND_RECREATE=1 just up).
SCARAB_ADDR=127.0.0.1:8080
# Vite dev server (`just ui`) proxies /v1 to this address (vite refuses to
# guess a default; see ui/scarab-web-ui/vite.config.ts). Same port as above.
SCARAB_API_URL=http://127.0.0.1:8080
