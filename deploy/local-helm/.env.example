# Local dogfood config — the SINGLE source of truth for deploy.sh + reseed.sh.
# Copy to deploy/local-helm/.env (gitignored) and fill in. Never commit real values.
#
#   cp deploy/local-helm/.env.example deploy/local-helm/.env
#
# This file is authoritative for the deploy (file-wins) for durable config +
# secrets: to change one, edit it here — a stale ambient var (e.g. a
# direnv-loaded .env.local) must not silently override the in-cluster config.
# EXCEPTION: the image source vars below are a per-run choice, so a caller
# (`just local-helm`) overrides them; these values are the direct-deploy.sh
# default.

# --- image (defaults for a direct deploy.sh run; `just local-helm` overrides
#     per invocation — bare = pull ghcr edge, `just local-helm local` = build) ---
IMAGE_REPOSITORY=scarab-server            # local build; or ghcr.io/thulasi-ram/scarab-server
IMAGE_TAG=dogfood-local                   # or a GHA tag, e.g. sha-<gitsha>

# --- release ---
NAMESPACE=scarab
DEV_INSECURE=true                         # dev only: auth off (every caller Owner)

# --- forge / GitHub App (ADR-0046) ---
SCARAB_GITHUB_APP_ID=<your-github-app-id>
SCARAB_PUBLIC_URL=https://<your-cloudflare-tunnel>.trycloudflare.com
SCARAB_CLONE_IMAGE=scarab-clone:dogfood
SCARAB_SIDECAR_IMAGE=scarab-results-sidecar:dogfood
SCARAB_STEP_TIMEOUT_SECS=14400            # laptop-suspend guard (wall-clock deadline)

# --- secrets (rendered into the chart Secret at deploy time) ---
SCARAB_DATABASE_URL=postgres://scarab:scarab@scarab-postgres.scarab.svc:5432/scarab
SCARAB_MASTER_KEY=<base64-32-byte-key>    # STABLE across redeploys, or stored secrets are lost
SCARAB_GITHUB_WEBHOOK_SECRET=<webhook-secret>   # must match the App's webhook config
SCARAB_RESULTS_TOKEN_SECRET=<results-token-secret>
# Workspace service (ADR-0061). deploy.sh generates a stable one under
# deploy/local-helm/.workspace-token-secret if this is unset, so the dogfood gets
# the service by default. MUST NOT equal SCARAB_RESULTS_TOKEN_SECRET: that token
# carries no verb and never expires, so reusing it would turn a results-write
# credential into a content read+write credential — and would let the workspace
# service forge step results for any {run, step, attempt}.
SCARAB_WORKSPACE_TOKEN_SECRET=<workspace-token-secret>
# The warm tier's PVC size. It is bounded by SPACE and LRU eviction is not
# implemented yet, so this is the whole budget — watch
# scarab_workspace_warm_used_bytes.
SCARAB_WORKSPACE_PV_SIZE=20Gi

# --- GitHub App private key: deploy.sh puts this file in a k8s Secret the chart
#     mounts, so the server has the credential AT BOOT and it survives a DB wipe
#     (no POST /v1/secrets). Unset => token mode / seed it through the API. ---
SCARAB_APP_PEM=/absolute/path/to/your-github-app.private-key.pem

# --- reseed (re-register the installation on a fresh DB) ---
SCARAB_INSTALL_ID=<your-app-installation-id>
SCARAB_ORG=<owner>
SCARAB_REPO=<repo>

# --- client ---
BASE=http://localhost:8899                # the port-forward the tunnel points at
