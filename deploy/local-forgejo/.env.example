# Forgejo verification tier — knobs (git-bug 3863d5e).
#
# OPTIONAL. `just forgejo-verify` runs with these defaults if you never create
# `deploy/local-forgejo/.env`; copy this file there only to change something
# (a port clash, a different Forgejo release). `.env` is gitignored.
#
# Nothing here is a real secret: this instance is created and destroyed by the
# recipe and holds nothing but throwaway repos.

# The Forgejo release under test. Pin deliberately — the whole point of this tier
# is to say WHICH Forgejo the adapter was proven against.
FORGEJO_IMAGE=codeberg.org/forgejo/forgejo:16.0.1

# Host port the instance is published on (container always listens on 3000).
FORGEJO_HTTP_PORT=3300

# The admin the tier acts as. Created on first `up.sh`.
FORGEJO_ADMIN_USER=scarab-admin
FORGEJO_ADMIN_PASSWORD=scarab-verify-pw-0
FORGEJO_ADMIN_EMAIL=scarab-admin@verify.invalid

# How many filler repos to create. MUST exceed the adapter's page size (50) so
# `list_accessible_repos` is forced onto a second page — an unpaginated
# implementation passes a one-page test and then truncates a real pick-list.
FORGEJO_PAD_REPOS=55

# How Forgejo reaches back out to the docker host: the Scarab under test and the
# adapter test's capture listener both live there. Docker Desktop and colima both
# resolve this name; compose maps it on plain Linux docker too.
FORGEJO_CALLBACK_HOST=host.docker.internal

# The HMAC secret the registered hooks are stamped with — the same one the
# server's /webhooks/forgejo verifies against (SCARAB_FORGEJO_WEBHOOK_SECRET).
FORGEJO_WEBHOOK_SECRET=forgejo-verify-hook-secret

# Where the Scarab under test listens (the local-proc stack's port). The recipe
# writes an env overlay pointing SCARAB_PUBLIC_URL at $FORGEJO_CALLBACK_HOST on
# this port, and makes the server bind 0.0.0.0 so the container can reach it.
SCARAB_VERIFY_PORT=8080
