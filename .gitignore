/target
**/*.rs.bk
.DS_Store

# dev harness runtime artifacts
/dev/.kubeconfig
/dev/server.pid
/dev/server.log
# local object-store backend (default dev fallback)
/.scarab

# machine-specific dev env (direnv loads it; see .env.local.example)
/.env.local
/.direnv

# Front-end projects (TS, not cargo members): scarab-web-ui, scarab-docs-ui
/ui/**/node_modules
/ui/**/dist
# Astro build output
/ui/**/.astro
