/target
**/*.rs.bk
.DS_Store

# dev harness runtime artifacts (local-proc mode)
/deploy/local-proc/.kubeconfig
/deploy/local-proc/server.pid
/deploy/local-proc/server.log
# local object-store backend (default dev fallback) and other runtime state
# under .scarab/ — but keep committed pipeline configs (.scarab/*.yaml and the
# .scarab/lib/ catalog) tracked; that is where a repo declares its own CI.
/.scarab/*
!/.scarab/*.yaml
!/.scarab/*.yml
!/.scarab/lib/


# Front-end projects (TS, not cargo members): scarab-web-ui, scarab-docs-ui
/ui/**/node_modules
/ui/**/dist
# Playwright runtime artifacts (scarab-web-ui e2e tier)
/ui/**/test-results
/ui/**/playwright-report
# Astro build output
/ui/**/.astro

# Git worktrees for parallel agents (local, not shared)
.workspaces/

# Env files may hold secrets now or later — never commit them; commit the
# `.env.example` templates instead. Matches `.env`, `.env.local`, etc. in any
# directory, while keeping the `.env.example` templates tracked.
.env
.env.*
!.env.example

# `.cargo/config.toml` IS tracked — repo-level build settings belong in version
# control. `cargo login` writes a registry token next to it, and that must never
# be committed; guard it now, while the file does not yet exist.
.cargo/credentials
.cargo/credentials.toml

# Gortex derives a "Community Skills" block and one SKILL.md per graph community
# from the LOCAL code index. Both are regenerated on every reindex and carry
# symbol counts that mean nothing on another machine, so they stay local. The
# hand-written agent instructions — CLAUDE.md and `.claude/agents/` — ARE
# tracked; only the generated files below are not. `.github/copilot-instructions.md`
# and `AGENTS.md` currently hold nothing but that generated block; drop these
# rules if either ever grows real content.
/.claude/skills/generated/
/.github/copilot-instructions.md
/AGENTS.md

# Stale generated copy of the canonical `/openapi.json`. Nothing reads it — the
# docs site points starlight-openapi at `../../openapi.json` in place
# (ui/scarab-docs-ui/astro.config.mjs).
/ui/scarab-docs-ui/openapi.gen.json
