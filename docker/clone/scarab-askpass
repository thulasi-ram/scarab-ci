#!/bin/sh
# GIT_ASKPASS helper (ADR-0045 token delivery, ADR-0076 §9 `forge_token`):
# git invokes this with a prompt string; we answer Username/Password from the
# tmpfs files under /scarab/secrets/ that `forge_token` mounts. The token therefore never appears in a URL, in argv, or in
# .git/config — the remote URL stays credential-free by construction.
#
# HOST-PINNED: the token answers ONLY for the clone URL's own host. A
# submodule URL is authored in-repo (.gitmodules — attacker-controlled on a
# fork PR), so a prompt for any other host gets no credential: same-forge
# repos the token doesn't cover fail at the forge (401), foreign hosts never
# see the token at all.

# The prompt names its target: "Username for 'https://host': " /
# "Password for 'https://user@host': ".
prompt_host=$(printf '%s' "$1" | sed -n "s/.*'[a-z+]*:\/\/\([^/']*\).*/\1/p" | sed 's/.*@//')
clone_host=$(printf '%s' "${SCARAB_CLONE_URL:-}" | sed -n 's/^[a-z+]*:\/\/\([^/]*\).*/\1/p' | sed 's/.*@//')
if [ -n "$prompt_host" ] && [ "$prompt_host" != "$clone_host" ]; then
  echo "scarab-askpass: refusing to answer for '$prompt_host' (token is pinned to '$clone_host')" >&2
  exit 1
fi

case "$1" in
  Username*)
    user_file="${SCARAB_CLONE_USERNAME_FILE:-/scarab/secrets/forge-username}"
    if [ -s "$user_file" ]; then cat "$user_file"; else printf '%s' "${SCARAB_CLONE_USERNAME:-x-access-token}"; fi ;;
  Password*) cat "${SCARAB_CLONE_TOKEN_FILE:-/scarab/secrets/forge-token}" ;;
  *) exit 1 ;;
esac
