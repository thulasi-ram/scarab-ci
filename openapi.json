{
  "openapi": "3.1.0",
  "info": {
    "title": "scarab-server",
    "description": "",
    "license": {
      "name": "MIT OR Apache-2.0",
      "identifier": "MIT OR Apache-2.0"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/v1/runs": {
      "get": {
        "tags": [],
        "summary": "The most recent runs, newest first — the runs-list view (ADR-0013, 0028).",
        "operationId": "list_runs",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "max runs to return (default 50, max 200)",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [],
        "summary": "Create and durably persist a new run from an inline pipeline.",
        "operationId": "create_run",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Run created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRunResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/runs/{id}": {
      "get": {
        "tags": [],
        "summary": "Current status of a run and its steps.",
        "operationId": "get_run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RunStatusResponse"
                }
              }
            }
          },
          "404": {
            "description": "no such run"
          }
        }
      }
    },
    "/v1/runs/{id}/events": {
      "get": {
        "tags": [],
        "summary": "Server-Sent-Events tail of the run's append-only event log — the status\ntimeline (ADR-0013): RunCreated, transitions, attempt start/finish.",
        "operationId": "get_events",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of the run's event log"
          }
        }
      }
    },
    "/v1/runs/{id}/gates/{step}/approve": {
      "post": {
        "tags": [],
        "summary": "Release a manual gate, resuming its suspended run (ADR-0008, 0032). Authz'd\nas a write; exactly-once (a repeat approve is a no-op).",
        "operationId": "approve_gate",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "step",
            "in": "path",
            "description": "gate step id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "gate released"
          },
          "404": {
            "description": "no such run or gate"
          }
        }
      }
    },
    "/v1/runs/{id}/gates/{step}/release": {
      "post": {
        "tags": [],
        "summary": "Release an **external** gate by presenting its token (ADR-0034) — the path an\noutside system (a deploy webhook, a change-management tool) uses instead of an\ninteractive approval. The token is `HMAC-SHA256(secret, \"{run}:{step}\")`\n(`sha256=<hex>`), verified in constant time; no per-gate storage. The endpoint\nis 404 when no token secret is configured, and only releases gates of kind\n`external` (manual gates stay approval-only).",
        "operationId": "release_gate_external",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "step",
            "in": "path",
            "description": "gate step id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "gate released"
          },
          "401": {
            "description": "bad or missing token"
          },
          "404": {
            "description": "no such external gate, or token release disabled"
          }
        }
      }
    },
    "/v1/runs/{id}/logs": {
      "get": {
        "tags": [],
        "summary": "Server-Sent-Events of step **log bodies** (ADR-0013): replays every\ncommitted chunk (decompressed from the object store, indexed by Postgres\noffsets), then — while the run is still going — live-tails new chunks via the\nlog pipeline's broadcast. A terminal run yields the full log and closes.",
        "operationId": "get_logs",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "SSE stream of step log output"
          }
        }
      }
    },
    "/v1/runs/{id}/steps/{step}/restart": {
      "post": {
        "tags": [],
        "summary": "Restart a step and its transitive descendants (ADR-0027 smart invalidation):\nthe target and every step depending on it are re-armed and re-run in\ndependency order; siblings and ancestors are left as-is.",
        "operationId": "restart_step",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "run id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "step",
            "in": "path",
            "description": "step id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "restart accepted"
          },
          "404": {
            "description": "no such run or step"
          }
        }
      }
    },
    "/v1/secrets": {
      "get": {
        "tags": [],
        "summary": "List the secret **names** at a scope (ADR-0014) — never the values.",
        "operationId": "list_secrets",
        "parameters": [
          {
            "name": "org",
            "in": "query",
            "description": "owning org",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "description": "repo (repo/env scope)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "description": "environment (env scope)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SecretListResponse"
                }
              }
            }
          },
          "404": {
            "description": "secrets not configured"
          }
        }
      },
      "post": {
        "tags": [],
        "summary": "Define (or overwrite) a secret at a scope (ADR-0014). The value is stored\nenvelope-encrypted and is **never** returned by any endpoint. Administering\nsecrets requires the Administer capability.",
        "operationId": "put_secret",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutSecretRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "secret stored"
          },
          "404": {
            "description": "secrets not configured"
          }
        }
      },
      "delete": {
        "tags": [],
        "summary": "Delete a secret at a scope (ADR-0014). Idempotent.",
        "operationId": "delete_secret",
        "parameters": [
          {
            "name": "org",
            "in": "query",
            "description": "owning org",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "repo",
            "in": "query",
            "description": "repo (repo/env scope)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "description": "environment (env scope)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "description": "secret name to delete",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "deleted (idempotent)"
          },
          "404": {
            "description": "secrets not configured"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CreateRunRequest": {
        "type": "object",
        "description": "`POST /v1/runs` body: an inline pipeline to run immediately.",
        "required": [
          "pipeline"
        ],
        "properties": {
          "pipeline": {
            "$ref": "#/components/schemas/PipelineDto"
          }
        }
      },
      "CreateRunResponse": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "PipelineDto": {
        "type": "object",
        "description": "The inline pipeline (IR subset).",
        "required": [
          "ir_version",
          "steps"
        ],
        "properties": {
          "ir_version": {
            "type": "integer",
            "format": "int32",
            "description": "IR schema version (ADR-0022).",
            "minimum": 0
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepDto"
            }
          }
        }
      },
      "PutSecretRequest": {
        "type": "object",
        "description": "`POST /v1/secrets` body: define (or overwrite) a secret at a scope. The\n`value` is **write-only** — no endpoint ever returns it.",
        "required": [
          "org",
          "name",
          "value"
        ],
        "properties": {
          "environment": {
            "type": [
              "string",
              "null"
            ],
            "description": "Environment, for an environment-scoped secret (requires `repo`)."
          },
          "name": {
            "type": "string",
            "description": "Secret name (the key steps reference)."
          },
          "org": {
            "type": "string",
            "description": "Owning org (required)."
          },
          "repo": {
            "type": [
              "string",
              "null"
            ],
            "description": "Repo, for a repo- or environment-scoped secret."
          },
          "value": {
            "type": "string",
            "description": "Secret value — stored envelope-encrypted, never returned."
          }
        }
      },
      "RunListResponse": {
        "type": "object",
        "description": "`GET /v1/runs` body: the most recent runs, newest first.",
        "required": [
          "runs"
        ],
        "properties": {
          "runs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RunSummaryDto"
            }
          }
        }
      },
      "RunStatusResponse": {
        "type": "object",
        "required": [
          "id",
          "status",
          "steps"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/StepStatusDto"
            }
          }
        }
      },
      "RunSummaryDto": {
        "type": "object",
        "description": "One run in the list view: identity, status, and creation time (epoch millis).",
        "required": [
          "id",
          "status",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "integer",
            "format": "int64"
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "SecretListResponse": {
        "type": "object",
        "description": "`GET /v1/secrets` body: the secret **names** at a scope. Values are never\nlisted.",
        "required": [
          "names"
        ],
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StepDto": {
        "type": "object",
        "description": "One step (IR subset): the step contract is an OCI `image` + `command`.",
        "required": [
          "id",
          "image"
        ],
        "properties": {
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "StepStatusDto": {
        "type": "object",
        "required": [
          "id",
          "status",
          "attempts"
        ],
        "properties": {
          "attempts": {
            "type": "integer",
            "minimum": 0
          },
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}