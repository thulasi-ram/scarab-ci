---
// Background doodle — ADR-0040 + docs/DESIGN.md §5.
// Places a committed, pre-generated rough.js SVG (see scripts/gen-doodles.mjs)
// faintly in the page background: rotated, scaled, low-opacity, pointer-events
// none, behind content, never on a control. ≤2 per page. No rough.js here — we
// only serve the static SVG the generator produced.
//
// The SVG is inlined (not <img>) so the motion script can target its <path>s
// for the "draw-on" (stroke-dashoffset) effect. Motion is best-effort and
// disabled under prefers-reduced-motion.
interface Props {
  icon: string;
  size?: number;      // px, 120–260 per DESIGN.md
  rotate?: number;    // deg, ~8–20 varied
  opacity?: number;   // 0.05–0.10
  top?: string; right?: string; bottom?: string; left?: string;
  parallax?: number;  // 0 = none; ~0.1–0.25 drift factor
}
const { icon, size = 200, rotate = 0, opacity = 0.08, top, right, bottom, left, parallax = 0.15 } = Astro.props;

const svgs = import.meta.glob('../assets/doodles/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const entry = Object.entries(svgs).find(([p]) => p.endsWith(`/${icon}.svg`));
const raw = entry?.[1];
if (!raw) throw new Error(`Doodle: unknown motif "${icon}" (run npm run gen:doodles)`);
---
{raw && (
  <span
    class="doodle"
    aria-hidden="true"
    data-parallax={parallax}
    style={`--doodle-size:${size}px;--doodle-rotate:${rotate}deg;--doodle-opacity:${opacity};` +
      (top ? `top:${top};` : '') + (right ? `right:${right};` : '') +
      (bottom ? `bottom:${bottom};` : '') + (left ? `left:${left};` : '')}
    set:html={raw}
  />
)}

<style is:global>
  .doodle {
    position: absolute;
    z-index: 0;
    width: var(--doodle-size);
    height: var(--doodle-size);
    opacity: var(--doodle-opacity);
    transform: rotate(var(--doodle-rotate)) translateY(0);
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }
  .doodle svg { width: 100%; height: 100%; display: block; }
  /* Keep doodles behind prose/code but let content sit above. */
  .sl-markdown-content { position: relative; z-index: 1; }
</style>

<script>
  // Motion: parallax drift + draw-on. Best-effort, reduced-motion aware. Hoisted
  // by Astro so it runs once regardless of how many <Doodle>s a page renders.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const doodles = Array.from(document.querySelectorAll<HTMLElement>('.doodle'));

  if (!reduce && doodles.length) {
    // Draw-on: sketch each path in when the doodle scrolls into view.
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        const paths = (e.target as HTMLElement).querySelectorAll<SVGPathElement>('path');
        paths.forEach((p, i) => {
          const len = p.getTotalLength();
          p.style.strokeDasharray = String(len);
          p.style.strokeDashoffset = String(len);
          p.style.transition = `stroke-dashoffset 1.1s ease ${i * 0.06}s`;
          requestAnimationFrame(() => { p.style.strokeDashoffset = '0'; });
        });
        io.unobserve(e.target);
      }
    }, { threshold: 0.15 });
    doodles.forEach((d) => io.observe(d));

    // Parallax: drift slower than scroll (rAF-throttled).
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const y = window.scrollY;
        for (const d of doodles) {
          const factor = Number(d.dataset.parallax ?? 0);
          if (factor) d.style.setProperty('transform', `rotate(var(--doodle-rotate)) translateY(${(-y * factor).toFixed(1)}px)`);
        }
        ticking = false;
      });
    };
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
