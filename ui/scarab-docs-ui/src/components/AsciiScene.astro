---
// Animated brand beetle — plays a baked ASCII scene from ui/brand/ascii
// (see its README). Landing page ONLY, per the placement rules there: no
// rendering code ships — the client script swaps pre-baked text frames.
//
// Frame 0 is rendered into the HTML at build time, so the scene is present at
// first paint; the player script upgrades it to the loop. Three <pre> layers
// (emerald / gold / gray) are colored via CSS so both themes work.
//
// `slotSelector` supports the hero: Starlight's hero.image.html is a static
// string, so the page puts an empty slot div there and this component moves
// itself into it during parse (inline script — before first paint).
/** Cell size in em — MUST match the line-height/letter-spacing below and the
 *  web-ui's ASCII_CELL. Bigger than JetBrains Mono's 0.6em advance on purpose:
 *  the dots stand apart and a solid fill reads as a dot matrix, not a slab.
 *  This also sizes the box, and the scene clips, so a mismatch crops the art. */
const ASCII_CELL = 0.9;

interface Props {
  name: string;
  fontSize?: number;      // px per glyph; a CELL is ASCII_CELL x this
  slotSelector?: string;
  label?: string;         // accessible name; omit → decorative (aria-hidden)
  class?: string;
  line?: string;          // speech-bubble text for a bubble stage (ponder-*)
}
const { name, fontSize = 8, slotSelector, label, class: cls, line } = Astro.props;

type Bubble = { from: number; to: number; col: number; row: number; place: "above" | "right" };
const scenes = import.meta.glob("../../../brand/ascii/generated/*.json", {
  import: "default",
  eager: true,
}) as Record<string, { cols: number; rows: number; fps: number; frames: [string, string, string][]; bubble?: Bubble }>;
const entry = Object.entries(scenes).find(([p]) => p.endsWith(`/${name}.json`));
if (!entry) throw new Error(`AsciiScene: unknown scene "${name}" (run npm run bake in ui/brand/ascii)`);
const scene = entry[1];
const [em0, au0, fe0] = scene.frames[0];
// Widest occupied column across every frame. The baked grid is padded to a
// uniform `cols` so a family of scenes can share one canvas — ponder-kingofhill
// puts a `place: "right"` bubble in columns 76..95, which the other ponder
// scenes leave empty. Sizing the box to `cols` would centre the BOX while the
// art sits left of centre. Measured here at build time; a bubble that reaches
// further widens the box in the player.
let boxCols = 0;
for (const frame of scene.frames)
  for (const layer of frame)
    for (const ln of layer.split('\n')) boxCols = Math.max(boxCols, ln.trimEnd().length);
const hasBubble = !!(scene.bubble && line);
const id = `ascii-${name}-${Math.random().toString(36).slice(2, 7)}`;
---

<div
  class:list={["ascii-scene", cls]}
  id={id}
  data-ascii={name}
  data-fps={scene.fps}
  data-line={hasBubble ? line : undefined}
  style={
    // Explicit box: layers are absolutely positioned, and trimmed text lines
    // must not size the scene (a layer can be much narrower than the grid).
    // JetBrains Mono's advance is exactly 0.6em and line-height is set to 0.6em
    // too, so cells are SQUARE — width AND height use the same 0.6 factor.
    `--ascii-fs:${fontSize}px;` +
    `width:${boxCols * fontSize * ASCII_CELL}px;` +
    `height:${scene.rows * fontSize * ASCII_CELL}px`
  }
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <pre class="ascii-em" data-layer="0">{em0}</pre>
  <pre class="ascii-au" data-layer="1">{au0}</pre>
  <pre class="ascii-fe" data-layer="2">{fe0}</pre>
  {hasBubble && <pre class="ascii-bubble" data-layer="3"></pre>}
</div>

{slotSelector && (
  <script is:inline define:vars={{ id, slotSelector }}>
    // Runs during parse: the hero slot is earlier in the DOM, so the scene is
    // in place before first paint — no flash at the wrong location.
    const slot = document.querySelector(slotSelector);
    const node = document.getElementById(id);
    if (slot && node) slot.appendChild(node);
  </script>
)}

<script>
  // One player for every scene on the page. Baked frames only — the dynamic
  // import pulls just the scenes this page actually uses.
  type Bubble = { from: number; to: number; col: number; row: number; place: "above" | "right" };

  // Compose a speech bubble sized to `line`, tail at the baked anchor. Returns
  // the bubble BLOCK plus its grid origin — not a rows-tall layer. The art is a
  // dot matrix on square cells (line-height = the 0.6em advance), but the
  // bubble is real TEXT: 1em glyphs in a 0.6em line box collide. Emitting just
  // the block lets the player anchor it and give it its own 1em line box.
  function composeBubble(line: string, b: Bubble, cols: number, rows: number) {
    const lines = line.split("\n");
    const maxw = Math.max(...lines.map((l) => l.length));
    const bw = maxw + 4;
    const bh = lines.length + 2;
    let top: number, left: number;
    if (b.place === "right") {
      left = Math.min(cols - bw, Math.max(0, b.col + 2));
      top = Math.max(0, Math.min(rows - bh, b.row - (bh >> 1)));
    } else {
      left = Math.max(0, Math.min(cols - bw, b.col - 2));
      top = Math.max(0, Math.min(rows - bh, b.row - bh - 1));
    }
    // The block spans the box PLUS the tail, which sits outside it: one row
    // below ("above") or one column to the left ("right").
    const c0 = b.place === "right" ? Math.max(0, left - 1) : left;
    const r0 = top;
    const w = left + bw - c0;
    const h = b.place === "right" ? bh : bh + 1;
    const grid: string[][] = Array.from({ length: h }, () => Array(w).fill(" "));
    const put = (r: number, c: number, ch: string) => {
      const rr = r - r0, cc = c - c0;
      if (rr >= 0 && rr < h && cc >= 0 && cc < w) grid[rr][cc] = ch;
    };
    put(top, left, "╭"); put(top, left + bw - 1, "╮");
    put(top + bh - 1, left, "╰"); put(top + bh - 1, left + bw - 1, "╯");
    for (let c = left + 1; c < left + bw - 1; c++) { put(top, c, "─"); put(top + bh - 1, c, "─"); }
    for (let r = top + 1; r < top + bh - 1; r++) { put(r, left, "│"); put(r, left + bw - 1, "│"); }
    lines.forEach((ln, i) => { for (let k = 0; k < ln.length; k++) put(top + 1 + i, left + 2 + k, ln[k]); });
    if (b.place === "right") put(Math.max(top + 1, Math.min(top + bh - 2, b.row)), left - 1, "╴");
    else put(top + bh, Math.max(left + 1, Math.min(left + bw - 2, b.col)), "╲");
    return { text: grid.map((r) => r.join("").replace(/\s+$/, "")).join("\n"), col: c0, row: r0 };
  }

  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const nodes = document.querySelectorAll<HTMLElement>("[data-ascii]");

  for (const node of nodes) {
    const name = node.dataset.ascii!;
    const line = node.dataset.line;
    import(`../../../brand/ascii/generated/${name}.json`).then((m) => {
      const { fps, frames, cols, rows, bubble } = m.default as {
        fps: number; frames: [string, string, string][]; cols: number; rows: number; bubble?: Bubble;
      };
      const pres = node.querySelectorAll("pre");
      // Composed once: neither the text nor its anchor changes per frame.
      const bub = bubble && line ? composeBubble(line, bubble, cols, rows) : null;
      if (bub && pres[3]) {
        const cell = parseFloat(node.style.getPropertyValue("--ascii-fs")) * 0.6;
        (pres[3] as HTMLElement).style.left = `${bub.col * cell}px`;
        (pres[3] as HTMLElement).style.top = `${bub.row * cell}px`;
        // A right-placed bubble can run past the art, up to the last column.
        const right = bub.col + Math.max(...bub.text.split("\n").map((l) => l.length));
        const needed = Math.min(cols, right) * cell;
        if (needed > parseFloat(node.style.width)) node.style.width = `${needed}px`;
      }
      const bubbleAt = (f: number) =>
        bub && f >= bubble!.from && f < bubble!.to ? bub.text : "";
      if (reduce) {
        // Hold a fully-open frame instead of animating (frame 0 is closed).
        const m2 = Math.floor(frames.length / 2);
        pres.forEach((p, i) => (p.textContent = i < 3 ? frames[m2][i] : bubbleAt(m2)));
        return;
      }
      let f = 0;
      setInterval(() => {
        if (document.hidden) return;
        f = (f + 1) % frames.length;
        for (let i = 0; i < 3; i++) pres[i].textContent = frames[f][i];
        if (pres[3]) pres[3].textContent = bubbleAt(f);
      }, 1000 / fps);
    });
  }
</script>

<style>
  .ascii-scene {
    position: relative;
    line-height: 0;
    max-width: 100%;
    overflow: hidden;
  }
  .ascii-scene pre {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    /* Pinned (NOT --sl-font-mono): the baked cell geometry assumes JetBrains
       Mono's exact 0.6em advance; a narrower mono would squash the scenes. */
    font-family: 'JetBrains Mono', ui-monospace, monospace;
    font-size: var(--ascii-fs, 8px);
    /* square cell = 0.6em advance x 0.6em line-height (no squash; bake aspect 1.0) */
    line-height: calc(var(--ascii-fs, 8px) * 0.9);
    letter-spacing: calc(var(--ascii-fs, 8px) * 0.3);
    /* The baked layers are trimmed of trailing spaces, so every row is a
       different length. An inherited `text-align: center` would then centre
       each row independently and shear the scene apart. */
    text-align: left;
    user-select: none;
    overflow: hidden;
  }
  /* brand-role layers; tokens themed in scarab.css */
  .ascii-scene .ascii-em { color: var(--ascii-emerald); }
  .ascii-scene .ascii-au { color: var(--ascii-gold); }
  .ascii-scene .ascii-fe { color: var(--ascii-gray); }
  /* Runtime speech bubble (ponder-* stages): crisp foreground text, off-language
     from the dot-matrix on purpose — reads as a terminal caption. Unlike the art
     layers it is real TEXT, so it does NOT take the square cell: 1em glyphs in a
     0.6em line box overlap into a smudge. It keeps a 1em line box and is
     anchored at its own origin (the player sets left/top). */
  .ascii-scene .ascii-bubble {
    color: var(--sl-color-white, var(--ascii-gray));
    inset: auto;
    line-height: var(--ascii-fs, 8px);
  }
</style>
