{
  "name": "scarab-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Scarab UI (SolidJS) — dogfoods the generated OpenAPI client. Scaffold; the rich live-DAG / SSE-logs / time-travel UI is an attended follow-up.",
  "type": "module",
  "scripts": {
    "gen": "openapi-typescript ../openapi.json -o src/api/schema.ts",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.0",
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "openapi-typescript": "^7.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-solid": "^2.10.0"
  }
}
