# direnv: the ONE variable that has to be ambient in this repo.
#
# Run `direnv allow` once after cloning (and again whenever this file changes).
#
# Why this exists: `just test` exports SCARAB_TEST_DATABASE_URL itself, but a
# test launched from an IDE/editor gutter never goes through the recipe — it
# inherits the shell, and without the URL the Postgres-backed tests skip or fail
# for a reason that looks like a code bug. See
# docs/audits/2026-07-24-test-strategy.md. Value matches the compose stack that
# `just test` boots (and reuses if something already serves 55432).
export SCARAB_TEST_DATABASE_URL="postgres://scarab:scarab@127.0.0.1:55432/scarab"

# Why this does NOT `dotenv .env.local`, tempting as that is:
#
# `.env.local` holds durable server config AND real secrets (OAuth client
# secret, master key). Loading it here would make SCARAB_ADDR,
# SCARAB_DATABASE_URL, SCARAB_EXECUTOR and SCARAB_MASTER_KEY ambient in every
# shell in this directory — and this repo has already been bitten by exactly
# that. `deploy/local-helm/deploy.sh` carries a hardening block whose comment
# names the failure by name ("a stale ambient value — e.g. a direnv-loaded
# .env.local — must NOT silently override the in-cluster config"), and the
# dogfood handoff records the rule as "never let a stale direnv .env.local var
# win".
#
# So `.env.local` stays a file that consumers load DELIBERATELY (the recipes
# source it, file-wins), never something the shell leaks into every command.
# If you genuinely want the full dev env in your shell, do it per-shell and
# on purpose:  set -a; . ./.env.local; set +a
